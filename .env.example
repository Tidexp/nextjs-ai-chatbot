# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Get your xAI API Key here for chat and image models: https://console.x.ai/
GEMINI_API_KEY=

# host your own instance of CodeLlama Inference API using the instructions here: https://github.com/your-repo/code-llama-inference
CODELLAMA_API_URL=

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=

# Google Drive Integration
# Your Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Your Google Client Secret (get from the same credentials page)
GOOGLE_CLIENT_SECRET=

# Your Google API Key (get this from Google Cloud Console > APIs & Services > Credentials)
# Create an API Key if you don't have one
NEXT_PUBLIC_GOOGLE_API_KEY=

# Your Google App ID (this is the project number from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_APP_ID=

# Hugging Face Configuration (for RAG embeddings - free tier)
# Get your API key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Google Cloud Vision API (for OCR)
GOOGLE_CLOUD_VISION_CREDENTIALS=